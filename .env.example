# Django Core Settings
DJANGO_SECRET_KEY=dev-only-change-me
# Optional: Read secret key from file (e.g. Docker Secrets)
# DJANGO_SECRET_KEY_FILE=/run/secrets/django_secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,eligius.donau-uni.ac.at
DJANGO_STATIC_ROOT=/djangoproject/site/public/static

# Hosts & Origins
CSRF_TRUSTED_ORIGINS=https://eligius.donau-uni.ac.at
# CORS: Comma-separated list for restricted environments; if unset/empty, all origins allowed in development
# CORS_ALLOWED_ORIGINS=https://eligius.donau-uni.ac.at

# Database Configuration (Development vs Production)
# Mode A: Development / Existing servers using MySQL cnf file (Preferred when DJANGO_DB_CNF_PATH is set)
DJANGO_DB_CNF_PATH=/djangoproject/auth/mysql.cnf

# Mode B: Docker / Container environment variables (Used when DJANGO_DB_CNF_PATH is not set)
# DATABASE_NAME=eligius
# DATABASE_USER=eligius
# DATABASE_PASSWORD=secret
# DATABASE_PASSWORD_FILE=/run/secrets/db_password
# DATABASE_HOST=localhost
# DATABASE_PORT=3306

# MCP & WebMCP Integration
ELIGIUS_MCP_ENABLED=0
ELIGIUS_EDITOR_MCP_ENABLED=0
ELIGIUS_WEBMCP_ENABLED=0
ELIGIUS_PUBLIC_BASE_URL=https://eligius.donau-uni.ac.at
ELIGIUS_MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*,eligius.donau-uni.ac.at
ELIGIUS_MCP_ALLOWED_ORIGINS=https://eligius.donau-uni.ac.at

# Docker Container / Server Startup (optional)
# GUNICORN_BIND=0.0.0.0:8080
# WEB_CONCURRENCY=2
# APP_SERVER=asgi
# GUNICORN_WORKER_CLASS=uvicorn.workers.UvicornWorker
# SERVER_START_CMD=
